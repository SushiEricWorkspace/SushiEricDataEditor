<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" prefHeight="400.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.toumokorosi01.sushiericdataeditor2.editor.controller.HomeController">

    <children>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="2.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                  <Label alignment="CENTER" contentDisplay="RIGHT" prefHeight="37.0" prefWidth="268.0" text="データ選択">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                        <Button styleClass="data-btn" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOpenItemEditor" text="アイテム" />
                        <Button styleClass="data-btn" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="鉱石" />
                        <Button styleClass="data-btn" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="作物" />
                        <Button styleClass="data-btn" focusTraversable="false" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onOpenMobEditor" text="モブ" />
                  <Region prefHeight="38.0" prefWidth="268.0" VBox.vgrow="ALWAYS" />
                  <Button styleClass="button, btn-danger" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDisconnect" style="-fx-background-color: #ff0000;" text="戻る" textFill="WHITE">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <VBox.margin>
                        <Insets top="100.0" />
                     </VBox.margin>
                  </Button>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
