<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="600.0" prefWidth="680.0"
            styleClass="server-control-root"
            xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.sushiericworkspace.sushiericservermanager.feature.servercontrol.ServerControlController">
    <top>
        <VBox styleClass="server-control-header">
            <children>
                <Label styleClass="server-control-title" text="Server Control" />
                <Label fx:id="connectionLabel" styleClass="server-control-note" />
                <HBox styleClass="server-control-actions">
                    <children>
                        <Button fx:id="startButton" onAction="#handleStart"
                                styleClass="button, btn-success" text="起動" />
                        <Button fx:id="stopButton" onAction="#handleStop"
                                styleClass="button, btn-danger" text="停止" />
                        <Button fx:id="restartButton" onAction="#handleRestart"
                                styleClass="button, btn-secondary" text="再起動" />
                    </children>
                </HBox>
                <Label fx:id="statusLabel" styleClass="server-control-status" wrapText="true" />
            </children>
        </VBox>
    </top>
    <center>
        <VBox styleClass="server-control-content">
            <children>
                <Label styleClass="server-control-section-title" text="コマンド設定" />
                <GridPane styleClass="server-control-grid">
                    <columnConstraints>
                        <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="320.0" />
                    </columnConstraints>
                    <Label styleClass="server-control-label" text="起動:" GridPane.rowIndex="0" />
                    <TextField fx:id="startCommandField" promptText="例: sudo systemctl start minecraft"
                               styleClass="server-control-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label styleClass="server-control-label" text="停止:" GridPane.rowIndex="1" />
                    <TextField fx:id="stopCommandField" promptText="例: sudo systemctl stop minecraft"
                               styleClass="server-control-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label styleClass="server-control-label" text="再起動:" GridPane.rowIndex="2" />
                    <TextField fx:id="restartCommandField" promptText="例: sudo systemctl restart minecraft"
                               styleClass="server-control-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>

                <HBox styleClass="server-control-actions">
                    <children>
                        <Button fx:id="saveButton" onAction="#handleSave"
                                styleClass="button, btn-primary" text="保存" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="importButton" onAction="#handleImport"
                                styleClass="button, btn-secondary" text="インポート..." />
                        <Button fx:id="exportButton" onAction="#handleExport"
                                styleClass="button, btn-secondary" text="エクスポート..." />
                    </children>
                </HBox>

                <Label styleClass="server-control-section-title" text="実行結果" />
                <TextArea fx:id="outputArea" editable="false" wrapText="true"
                          styleClass="server-control-output" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
    <bottom>
        <Label styleClass="server-control-note" wrapText="true"
               text="操作はSSHで上記のコマンドを実行します。未設定の操作は実行できません。起動コマンドには、実行後すぐ制御を返すものを登録してください。インポートしたコマンドは、実行前に内容を確認してください。" />
    </bottom>
</BorderPane>
